# Copy to .env and fill in. Never commit .env.

# Azure Bot identity (Single Tenant). Leave all four empty to use the Bot Framework Emulator locally.
MicrosoftAppType=SingleTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# Azure AI Language resource (hosts both CLU and Custom Question Answering)
LanguageEndpoint=https://<your-language-resource>.cognitiveservices.azure.com/
LanguageKey=
# Optional: run CLU on a separate Language resource (leave empty to share the one above)
CluEndpoint=
CluKey=
CluProjectName=ContosoDentistryCLU
CluDeploymentName=production
CqaProjectName=ContosoDentistryFAQ
CqaDeploymentName=production

# Confidence needed before acting on a scheduling intent / sending a knowledge base answer
IntentThreshold=0.6
AnswerThreshold=0.5

# Dentist Scheduler API (the ContosoDentistryScheduler web app)
SchedulerEndpoint=https://<your-scheduler-app>.azurewebsites.net/

# Web Chat on the website: Direct Line channel secret and the site origins allowed to request tokens
DirectLineSecret=
AllowedOrigins=https://<your-static-web-app>.azurestaticapps.net,http://localhost:4280

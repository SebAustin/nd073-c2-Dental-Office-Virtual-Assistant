{
    "name": "contoso-dentistry-chatbot",
    "version": "2.0.0",
    "description": "Contoso Dentistry virtual assistant: answers FAQs (Custom Question Answering) and schedules appointments (CLU + Dentist Scheduler API).",
    "main": "index.js",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "node ./index.js",
        "watch": "node --watch ./index.js",
        "test": "jest",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "botbuilder": "^4.23.3",
        "dotenv": "^16.4.7",
        "express": "^5.1.0"
    },
    "devDependencies": {
        "jest": "^30.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "collectCoverageFrom": [
            "src/**/*.js",
            "bot.js",
            "intentrecognizer.js",
            "dentistscheduler.js"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 80,
                "functions": 80,
                "lines": 80,
                "statements": 80
            }
        }
    }
}
